  </materials>
  <looks>
    <look name="black" gray="0.05" roughness="0.2"/>
    <look name="Blue" rgb="0.0 0.3 1.0" roughness="0.3"/>
    <look name="None" gray="0.5" roughness="0.5"/>
  </looks>
