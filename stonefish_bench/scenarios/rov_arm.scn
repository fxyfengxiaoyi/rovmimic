		<link name="ArmBaseLink" type="model" physics="surface">
            <physical>
                <mesh filename="robot_arm/base_link_uji_hydro.obj" scale="1.0" />
                <thickness value="0.0" />
                <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
			</physical>
            <material name="Dummy" />
            <look name="manipulator" />
        </link>

        
        <link name="ArmLink1" type="model" physics="surface">
            <physical>
                <mesh filename="robot_arm/link1_hydro.obj" scale="1.0" />
                <thickness value="0.0" />
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            </physical>
