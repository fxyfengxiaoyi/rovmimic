            <controller position_gain="1.0" velocity_gain="1.0" max_torque="100.0" />
            <joint name="Joint4" />
        </actuator>

        <actuator name="FServo1" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="10.0" />
            <joint name="Joint5" />
        </actuator>

        <actuator name="FServo2" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="10.0" />
            <joint name="Joint6" />
        </actuator>

		
		<joint name="AttachToRobot" type="fixed">
			<parent name="base_link" />
			<child name="ArmBaseLink" />
			<origin xyz="0.74 0.0 0.0" rpy="0 0 0" />
		</joint>

		<world_transform xyz="0.0 0.0 5.0" rpy="0.0 0.0 0.0" />
		
		</robot>

</scenario>
