                <mesh filename="robot_arm/link3_hydro.obj" scale="1.0" />
                <thickness value="0.0" />
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            </physical>
            <material name="Dummy" />
            <look name="manipulator" />
        </link>

        
        <link name="ArmLink4" type="model" physics="surface">
            <physical>
                <mesh filename="robot_arm/link4ft_hydro.obj" scale="1.0" />
                <thickness value="0.0" />
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            </physical>
            <material name="Dummy" />
            <look name="link4" />
        </link>

        
        <link name="EE" type="model" physics="surface">
            <physical>
                <mesh filename="robot_arm/eeprobe_hydro.obj" scale="1.0" />
                <thickness value="0.0" />
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            </physical>
            <material name="Neutral" />
            <look name="manipulator" />
        </link>

        
        <link name="Finger1" type="model" physics="surface">
            <physical>
                <mesh filename="robot_arm/fingerA_hydro.obj" scale="1.0" />
                <thickness value="0.0" />
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            </physical>
            <material name="Dummy" />
            <look name="manipulator" />
        </link>

        
        <link name="Finger2" type="model" physics="surface">
            <physical>
                <mesh filename="robot_arm/fingerA_hydro.obj" scale="1.0" />
                <thickness value="0.0" />
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            </physical>
            <material name="Dummy" />
            <look name="manipulator" />
        </link>

        
        <joint name="Joint1" type="revolute">
            <parent name="ArmBaseLink" />
            <child name="ArmLink1" />
            <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
            <axis xyz="0.0 0.0 1.0" />
            <limit lower="-1.0" upper="1.0" />
        </joint>

        <joint name="Joint2" type="revolute">
            <parent name="ArmLink1" />
            <child name="ArmLink2" />
            <origin xyz="0.1065 0.0 0.0" rpy="0 0 0" />
            <axis xyz="0.0 1.0 0.0" />
            <limit lower="-1.0" upper="1.0" />
        </joint>

        <joint name="Joint3" type="revolute">
            <parent name="ArmLink2" />
            <child name="ArmLink3" />
            <origin xyz="0.23332 0.0 0.0" rpy="0 0 0" />
            <axis xyz="0.0 1.0 0.0" />
            <limit lower="-1.0" upper="1.0" />
        </joint>

        <joint name="Joint4" type="revolute">
            <parent name="ArmLink3" />
            <child name="ArmLink4" />
            <origin xyz="0.103 0.0 0.201" rpy="0 0 0" />
            <axis xyz="0.0 0.0 1.0" />
            <limit lower="-1.0" upper="1.0" />
        </joint>

        <joint name="Fix" type="fixed">
            <parent name="ArmLink4" />
            <child name="EE" />
            <origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
        </joint>

        <joint name="Joint5" type="revolute">
            <parent name="EE" />
            <child name="Finger1" />
            <origin xyz="0.03 0 0.1" rpy="0 0 0" />
            <axis xyz="0.0 1.0 0.0" />
            <limit lower="0.0" upper="1.0" />
        </joint>

        <joint name="Joint6" type="revolute">
            <parent name="EE" />
            <child name="Finger2" />
            <origin xyz="-0.03 0 0.1" rpy="3.14159 0 0" />
            <axis xyz="0.0 1.0 0.0" />
            <limit lower="0.0" upper="1.0" />
        </joint>

        
        <actuator name="Servo1" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="100.0" />
            <joint name="Joint1" />
        </actuator>

        <actuator name="Servo2" type="servo">
            <controller position_gain="1.0" velocity_gain="1.0" max_torque="100.0" />
